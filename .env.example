# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify (TikTok + Instagram scrapers)
APIFY_TOKEN=apify_api_...

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
# Renamed from SUPABASE_SERVICE_KEY to match agent1/agent3's naming.
# The code still accepts the old name as a fallback, so re-deploying
# with the existing Railway env var will keep working — rename it in
# Railway when convenient.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Discord
DISCORD_WEBHOOK_KASPR_LOGS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_KASPR_ERRORS=https://discord.com/api/webhooks/...

# MODE: "cron" (run once, exit) or "daemon" (stay alive, poll OpenClaw)
MODE=daemon
